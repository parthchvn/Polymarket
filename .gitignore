__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pytest_cache/
.ruff_cache/
.coverage

# never commit production data or secrets
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
outputs/
*.key
*.pem

# the synthetic fixture IS committed; ignore its sqlite side files
fixtures/*.sqlite-wal
fixtures/*.sqlite-shm

# local run data and large datasets
runs/
